# wow-armory-server environment example.
# Copy to `.env` for local development. Every value below is fictitious.
# Development and test start without any of these variables.

# --- Runtime ---------------------------------------------------------------
# development | test | production (default: development)
NODE_ENV=development
# 1-65535 (default: 3000). PaaS providers usually inject it.
PORT=3000
# Reported by GET /health (default: version from package.json).
APP_VERSION=1.2.0

# --- Session ---------------------------------------------------------------
# Required in production, >= 32 chars. Generate with: openssl rand -hex 32
# Outside production an ephemeral secret is generated when empty.
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
# memory | redis (default: redis when REDIS_URL is set, otherwise memory).
# Production without REDIS_URL requires SESSION_STORE=memory explicitly.
SESSION_STORE=memory
# Required when SESSION_STORE=redis. redis:// or rediss:// (TLS, e.g. Upstash).
REDIS_URL=rediss://default:example-password@example-host.upstash.io:6379
# Session lifetime in ms, used for the cookie maxAge and the Redis TTL.
SESSION_TTL_MS=86400000

# --- Battle.net ------------------------------------------------------------
# Required in production.
BLIZZARD_CLIENT_ID=example-client-id
BLIZZARD_CLIENT_SECRET=example-client-secret
# Required in production, must be https:// there.
BLIZZARD_REDIRECT_URI=http://localhost:3000/auth/callback
# us | eu | kr | tw (default: us)
BLIZZARD_REGION=us
# Locale for names returned by Blizzard (default: en_US), e.g. es_MX, es_ES.
BLIZZARD_LOCALE=en_US
# Every namespace below defaults to the BLIZZARD_REGION value; set them only
# to override. Classic profile namespace (default: profile-classic-<region>).
# Use profile-classic1x-<region> for Classic Era realms.
BLIZZARD_NAMESPACE=profile-classic-us
# Optional per-mode overrides:
# BLIZZARD_NAMESPACE_CLASSIC=profile-classic-us
# BLIZZARD_NAMESPACE_RETAIL=profile-us
# BLIZZARD_STATIC_NAMESPACE_CLASSIC=static-classic-us
# BLIZZARD_STATIC_NAMESPACE_RETAIL=static-us
# BLIZZARD_DYNAMIC_NAMESPACE_CLASSIC=dynamic-classic-us
# BLIZZARD_DYNAMIC_NAMESPACE_RETAIL=dynamic-us
# Refresh access tokens this many ms before they expire (default: 60000).
TOKEN_REFRESH_MARGIN_MS=60000

# --- Client, CORS and cookies ----------------------------------------------
# Required in production (https://). Default: http://localhost:5173
CLIENT_URL=http://localhost:5173
# Comma-separated origins (scheme://host[:port], no path, no *).
# Default: origin of CLIENT_URL. Must include it in production (https only).
CORS_ORIGINS=http://localhost:5173
# Default: true in production, false otherwise. Must be true in production.
COOKIE_SECURE=false
# lax | strict | none (default: lax). none requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
# Optional cookie domain, e.g. .example.com (default: API host only).
COOKIE_DOMAIN=
# true | false | number of proxy hops (default: 1 in production, false otherwise).
TRUST_PROXY=false

# --- Logging ---------------------------------------------------------------
# error | warn | log | debug | verbose (default: log)
LOG_LEVEL=log
# json | pretty (default: json in production, pretty otherwise)
LOG_FORMAT=pretty

# --- Rate limiting (in memory, per instance) -------------------------------
# Window in ms (default: 60000).
RATE_LIMIT_TTL_MS=60000
# Requests per window and IP for /auth/login, /auth/callback, /auth/logout.
RATE_LIMIT_AUTH_LIMIT=10
# Requests per window and IP for /auth/session and /characters/... (default: 60).
RATE_LIMIT_PUBLIC_LIMIT=60
